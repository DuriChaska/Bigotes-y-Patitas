rules_version = '2';

// Reglas de seguridad de Firestore para "Bigotes y Patitas".push automatico
// Cópialas en Firebase Console → Firestore Database → Reglas,
// o despliégalas con la CLI de Firebase (firebase deploy --only firestore:rules).
//
// Hay dos familias de cuenta de Firebase Authentication en este proyecto:
//  - Personal del panel: tiene perfil en "usuarios" con un rol:
//      administrador -> todo (CRM + SCM + ERP + gestión de usuarios)
//      vendedor      -> CRM (clientes e interacciones), consulta de productos e
//                       inventario, y órdenes del ERP (puede crearlas)
//      logistica     -> SCM completo (productos, proveedores, inventario, pedidos,
//                       movimientos, madurez) y órdenes del ERP (las despacha:
//                       cambia su estado y devuelve el stock si se cancelan)
//      soporte       -> SOLO atención a clientes (tickets) y consulta de la ficha del
//                       cliente en el CRM (compras / total gastado). No ve finanzas,
//                       inventario ni órdenes.
//  - Cliente: tiene perfil en "clientes/{uid}" (mismo id que su cuenta de
//    Authentication). Se registra desde el sitio público.
// Por eso NO se puede usar "request.auth != null" a secas para dar acceso
// de personal: eso también es verdad para un cliente cualquiera. Las
// funciones esAdmin()/esStaff()/esScm() (más abajo) son las que de verdad
// distinguen quién puede qué.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers de rol (usados por TODA la colección, no solo SCM) ----
    // Rol guardado en el perfil de quien hace la petición ('' si no tiene perfil).
    function rolActual() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
        : '';
    }
    function esAdmin() {
      return rolActual() == 'administrador';
    }
    // CRM (clientes, interacciones, ventas): administrador y vendedor.
    function esStaff() {
      return rolActual() in ['administrador', 'vendedor'];
    }
    // SCM (cadena de suministros): administrador y logística.
    function esScm() {
      return rolActual() in ['administrador', 'logistica'];
    }
    // Cualquier persona del panel, sea cual sea su rol (perfiles y operaciones del ERP).
    function esPersonal() {
      return rolActual() in ['administrador', 'vendedor', 'logistica'];
    }
    // Atención a clientes (tickets): administrador y soporte.
    function esSoporte() {
      return rolActual() in ['administrador', 'soporte'];
    }
    // Cualquier cuenta con perfil en "usuarios" (incluye soporte). Solo para que el
    // panel pueda leer el propio rol al entrar; NO da acceso a finanzas.
    function esPanel() {
      return rolActual() in ['administrador', 'vendedor', 'logistica', 'soporte'];
    }

    // ---- Clientes: CRM (personal) + cuentas reales de clientes ----
    // - El personal (esStaff) puede ver y gestionar cualquier cliente, igual que antes.
    // - Un cliente con cuenta real solo puede leer/editar SU PROPIO documento
    //   (el id del documento es el mismo uid de su cuenta de Authentication),
    //   y solo puede tocar sus datos de contacto, no su etapa/estado (eso es del CRM).
    function clienteValido(d) {
      return d.nombre is string && d.nombre.size() > 0
        && d.correo is string && d.correo.size() > 0
        && d.etapa == 'Prospecto';
    }
    // Etapa 4: "correo" solo puede cambiar al correo YA VERIFICADO de su propia cuenta
    // (después de que la persona abrió el enlace que Firebase le mandó al correo nuevo).
    function soloCamposDeContacto() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['nombre', 'telefono', 'mascota', 'direccion', 'correo', 'actualizadoEn'])
        && (request.resource.data.get('correo', '') == resource.data.get('correo', '')
            || request.resource.data.correo == request.auth.token.email);
    }

    // Sincronización CRM de una compra hecha en la tienda (Etapa 4). El cliente solo puede
    // sumar UNA compra a la vez y solo si en la MISMA operación se crea el documento
    // pagos/{ventaId} de una venta suya (getAfter), por la cual el total gastado sube
    // exactamente lo que costó esa venta. "ultimaVentaId" + "pagos/{id} no existía antes"
    // impiden repetir la misma compra para inflar las cifras.
    function esSincronizacionDeCompra(clienteId) {
      return request.auth != null && request.auth.uid == clienteId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['numCompras', 'totalComprado', 'ultimaCompra', 'ultimaVentaId', 'etapa', 'actualizadoEn'])
        && request.resource.data.ultimaVentaId is string
        && !exists(/databases/$(database)/documents/pagos/$(request.resource.data.ultimaVentaId))
        && existsAfter(/databases/$(database)/documents/pagos/$(request.resource.data.ultimaVentaId))
        && get(/databases/$(database)/documents/ventas/$(request.resource.data.ultimaVentaId)).data.clienteId == request.auth.uid
        && request.resource.data.numCompras == (('numCompras' in resource.data ? resource.data.numCompras : 0) + 1)
        && request.resource.data.totalComprado
             >= (('totalComprado' in resource.data ? resource.data.totalComprado : 0)
                  + get(/databases/$(database)/documents/ventas/$(request.resource.data.ultimaVentaId)).data.total - 0.01)
        && request.resource.data.totalComprado
             <= (('totalComprado' in resource.data ? resource.data.totalComprado : 0)
                  + get(/databases/$(database)/documents/ventas/$(request.resource.data.ultimaVentaId)).data.total + 0.01)
        && request.resource.data.etapa in ['Activo', 'Frecuente'];
    }

    match /clientes/{clienteId} {
      // Soporte solo LEE (para ver compras y total gastado junto al ticket).
      allow read: if esStaff() || esSoporte() || (request.auth != null && request.auth.uid == clienteId);
      allow update: if esStaff()
                    || (request.auth != null && request.auth.uid == clienteId && soloCamposDeContacto())
                    || esSincronizacionDeCompra(clienteId);
      allow delete: if esStaff();
      allow create: if (esStaff() && clienteValido(request.resource.data))
                    || (request.auth != null && request.auth.uid == clienteId && clienteValido(request.resource.data));

      // Etapa 4: direcciones guardadas del cliente (Mi cuenta → Direcciones y el checkout).
      // Solo el dueño las crea, edita y borra; el personal de ventas puede consultarlas.
      match /direcciones/{direccionId} {
        allow read: if (request.auth != null && request.auth.uid == clienteId) || esStaff();
        allow create, update: if request.auth != null && request.auth.uid == clienteId
                              && direccionValida(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == clienteId;
      }
    }

    function direccionValida(d) {
      return d.keys().hasOnly(['alias', 'nombre', 'apellido', 'pais', 'calle', 'ciudad', 'estado', 'cp',
                               'telefono', 'referencias', 'predeterminada', 'creadoEn', 'actualizadoEn'])
        && d.alias is string && d.alias.size() <= 40
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 60
        && d.apellido is string && d.apellido.size() > 0 && d.apellido.size() <= 60
        && d.pais is string && d.pais.size() <= 60
        && d.calle is string && d.calle.size() >= 5 && d.calle.size() <= 200
        && d.ciudad is string && d.ciudad.size() > 0 && d.ciudad.size() <= 80
        && d.estado is string && d.estado.size() > 0 && d.estado.size() <= 80
        && d.cp is string && d.cp.matches('[0-9]{5}')
        && d.telefono is string && d.telefono.matches('[0-9]{10}')
        && d.referencias is string && d.referencias.size() <= 300
        && d.predeterminada is bool;
    }

    // ---- Interacciones (CRM): solo personal ----
    match /interacciones/{interaccionId} {
      allow read, write: if esStaff();
    }

    // ---- Usuarios (perfiles de personal): cualquier persona del panel puede
    // leerlos (el panel necesita leer su propio rol al entrar); solo un
    // administrador puede crear/editar/borrar perfiles, y solo con un rol válido ----
    function rolValido(d) {
      return d.rol in ['administrador', 'vendedor', 'logistica', 'soporte'];
    }
    match /usuarios/{uid} {
      allow read: if esPanel();
      allow create, update: if esAdmin() && rolValido(request.resource.data);
      allow delete: if esAdmin();
    }

    // ---- SCM (cadena de suministros): gestión de administradores y logística.
    // La única excepción es la LECTURA del catálogo (scm_productos), que es
    // pública porque alimenta las páginas de la tienda, y la actualización de
    // stock/el registro del movimiento que hace una compra real de un cliente
    // (ver más abajo). Ni vendedores, ni clientes, ni cuentas sin perfil pueden
    // gestionar el resto del módulo: esta es la barrera real, el menú oculto y
    // la redirección de las páginas son solo cortesía de la interfaz.
    function productoScmValido(d) {
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.stock is int && d.stock >= 0
        && d.stockMin is int && d.stockMin >= 0
        && d.estrategia in ['PUSH', 'PULL']
        && d.costo is number && d.costo >= 0
        && d.precio is number && d.precio >= 0;
    }
    // Una compra real solo puede TOCAR el stock (bajarlo), nunca el resto del producto.
    function esDescuentoDeStockPorVenta() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'actualizadoEn'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    match /scm_productos/{productoId} {
      allow read: if true; // catálogo público: lo usan index/shop/producto sin necesidad de sesión
      allow delete: if esScm();
      allow create: if esScm() && productoScmValido(request.resource.data);
      allow update: if (esScm() && productoScmValido(request.resource.data)) || esDescuentoDeStockPorVenta();
    }

    function proveedorScmValido(d) {
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.contacto is string && d.contacto.size() <= 120
        && d.correo is string && d.correo.size() <= 200
        && d.telefono is string && d.telefono.size() <= 40
        && d.direccion is string && d.direccion.size() <= 300;
    }

    match /scm_proveedores/{proveedorId} {
      allow read, delete: if esScm();
      allow create, update: if esScm() && proveedorScmValido(request.resource.data);
    }

    function pedidoScmValido(d) {
      return d.folio is string
        && d.productoId is string && d.productoId.size() > 0
        && d.cantidad is int && d.cantidad > 0
        && d.tipo in ['Reposición', 'Venta']
        && d.estado in ['Pendiente', 'En proceso', 'Surtido', 'Cancelado']
        && d.fecha is string;
    }

    match /scm_pedidos/{pedidoId} {
      allow read, delete: if esScm();
      allow create, update: if esScm() && pedidoScmValido(request.resource.data);
    }

    function movimientoScmValido(d) {
      return d.productoId is string && d.productoId.size() > 0
        && d.tipo in ['Entrada', 'Salida']
        && d.cantidad is int && d.cantidad > 0
        && d.fecha is string;
    }

    match /scm_movimientos/{movimientoId} {
      allow read: if esScm();
      // El personal de SCM registra entradas y salidas manuales; una compra real de un
      // cliente registra su propia salida (siempre autenticado, siempre "Salida").
      allow create: if (esScm() && movimientoScmValido(request.resource.data))
                    || (request.auth != null && movimientoScmValido(request.resource.data)
                        && request.resource.data.tipo == 'Salida');
      // Los movimientos son un historial: no se editan ni se borran, solo se agregan.
    }

    // Checklist manual del nivel de madurez SCM (un solo documento: "madurez").
    match /scm_estado/{estadoId} {
      allow read: if esScm();
      allow write: if esScm() && request.resource.data.items is map;
    }

    // ---- Ventas: compras reales hechas por clientes desde la tienda ----
    // Un cliente solo puede crear (y leer) SUS PROPIAS ventas; el personal puede
    // leer todas (para dar soporte). Son un historial: no se editan ni se borran.
    function ventaValida(d) {
      return d.clienteId is string && d.clienteId.size() > 0
        && d.items is list && d.items.size() > 0
        && d.total is number && d.total >= 0
        && d.folio is string;
    }

    // ERP: el personal de ventas (administrador/vendedor) registra órdenes a nombre
    // de un cliente del CRM (dejando constancia de quién la hizo: usuarioId), y
    // logística/administrador despachan: SOLO pueden cambiar el estado de la orden
    // (y su historial), nunca sus productos ni su total.
    // Etapa 4: el rol ventas (vendedor) TAMBIÉN cambia el estatus (En proceso / Enviada /
    // Entregada). Cancelar una orden devuelve stock al inventario (SCM), así que cancelar
    // sigue siendo solo de administrador y logística.
    function cambioDeEstadoDeOrdenValido() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadoEn', 'historial'])
        && request.resource.data.estado in ['Confirmada', 'En proceso', 'Enviada', 'Entregada', 'Cancelada']
        && (request.resource.data.estado != 'Cancelada' || esScm());
    }

    // Etapa 4: una venta "pagada con monedero" solo puede crearse si en la MISMA transacción
    // se descontó el saldo del monedero con un movimiento "Pago" que apunta a esta venta.
    function pagoConMonederoHecho(ventaId) {
      return request.resource.data.get('metodoPagoClave', '') != 'monedero'
        || getAfter(/databases/$(database)/documents/monedero_movimientos/$(
             getAfter(/databases/$(database)/documents/monederos/$(request.auth.uid)).data.ultimoMovimientoId
           )).data.ventaId == ventaId;
    }

    match /ventas/{ventaId} {
      allow read: if esStaff() || esScm() || (request.auth != null && resource.data.clienteId == request.auth.uid);
      allow create: if (request.auth != null
          && request.resource.data.clienteId == request.auth.uid
          && ventaValida(request.resource.data)
          && pagoConMonederoHecho(ventaId))
        || (esStaff()
          && ventaValida(request.resource.data)
          && request.resource.data.usuarioId == request.auth.uid);
      allow update: if (esScm() || esStaff()) && cambioDeEstadoDeOrdenValido();
    }

    // Historial de operaciones empresariales del ERP (órdenes creadas, cambios de
    // estado, cancelaciones). Es un registro: solo se agregan, no se editan ni borran.
    function operacionErpValida(d) {
      return d.tipo is string && d.tipo.size() > 0
        && d.descripcion is string && d.descripcion.size() <= 500
        && d.usuarioId == request.auth.uid;
    }

    // Compra hecha por un cliente en la tienda: deja su registro empresarial (origen "Tienda web")
    // siempre ligado a una venta suya ya guardada.
    function operacionDeTiendaValida(d) {
      return request.auth != null
        && d.tipo == 'Compra en tienda'
        && d.descripcion is string && d.descripcion.size() <= 500
        && d.usuarioId == request.auth.uid
        && d.clienteId == request.auth.uid
        && d.ordenId is string
        && get(/databases/$(database)/documents/ventas/$(d.ordenId)).data.clienteId == request.auth.uid;
    }

    match /erp_operaciones/{operacionId} {
      allow read: if esPersonal();
      allow create: if (esPersonal() && operacionErpValida(request.resource.data))
                    || operacionDeTiendaValida(request.resource.data);
    }

    // ---- Pagos (Etapa 4): modelo separado de la venta ----
    // pagos/{id} usa como id el MISMO id de la venta/orden (uno por venta, así no se duplica).
    //   { pedidoId, folio, clienteId, clienteNombre, monto, metodoPago, estado, origen,
    //     usuarioId, usuarioNombre, fecha, creadoEn }
    // - Cliente: crea el pago de SU venta, con el monto exacto de esa venta; lee solo los suyos.
    // - Ventas/admin (ERP): crean el pago de las órdenes que registran.
    // - Cambios posteriores: solo el estado (p. ej. "Cancelado" al cancelar la orden).
    function pagoDeClienteValido(d, pagoId) {
      return request.auth != null
        && d.clienteId == request.auth.uid
        && d.pedidoId == pagoId
        && d.monto is number && d.monto >= 0
        // OXXO / SPEI nacen "Pendiente" (con su referencia); tarjeta, PayPal y puntos "Pagado".
        && d.estado in ['Pagado', 'Pendiente']
        && d.estado == get(/databases/$(database)/documents/ventas/$(pagoId)).data.estadoPago
        && d.metodoPago is string
        && get(/databases/$(database)/documents/ventas/$(pagoId)).data.clienteId == request.auth.uid
        && d.monto == get(/databases/$(database)/documents/ventas/$(pagoId)).data.total;
    }
    function pagoDeErpValido(d, pagoId) {
      return esStaff()
        && d.pedidoId == pagoId
        && d.monto is number && d.monto >= 0
        && d.estado == 'Pagado'
        && d.usuarioId == request.auth.uid;
    }

    match /pagos/{pagoId} {
      allow read: if esStaff() || esScm() || (request.auth != null && resource.data.clienteId == request.auth.uid);
      allow create: if pagoDeClienteValido(request.resource.data, pagoId)
                    || pagoDeErpValido(request.resource.data, pagoId);
      allow update: if (esStaff() || esScm())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadoEn'])
                    && request.resource.data.estado in ['Pagado', 'Pendiente', 'Cancelado', 'Reembolsado'];
    }

    // ---- Impuestos (Etapa 4): configuración del IVA ----
    // impuestos/iva { nombre, tasa, activo, incluidoEnPrecio, actualizadoPor, actualizadoPorId, actualizadoEn }
    // Cualquiera la LEE (el checkout la necesita para calcular el total); solo el administrador la cambia.
    function impuestoValido(d) {
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 30
        && d.tasa is number && d.tasa >= 0 && d.tasa <= 30
        && d.activo is bool
        && d.incluidoEnPrecio is bool
        && d.actualizadoPorId == request.auth.uid;
    }

    match /impuestos/{impuestoId} {
      allow read: if true;
      allow create, update: if esAdmin() && impuestoValido(request.resource.data);
      allow delete: if esAdmin();
    }

    // ---- Promociones (Etapa 4): cupones con vigencia, ya no fijos en el código ----
    // El código del cupón es el id del documento. Cualquiera puede LEER uno si sabe su código
    // (get), pero solo el personal de ventas puede listarlos o modificarlos.
    function promocionValida(d, promoId) {
      return d.codigo is string && d.codigo == promoId && d.codigo.size() >= 3 && d.codigo.size() <= 30
        && d.tipo in ['porcentaje', 'tercera_prenda', 'envio_gratis']
        && d.valor is number && d.valor >= 0 && d.valor <= 90
        && d.vigenciaHasta is string && d.vigenciaHasta.size() == 10
        && d.activa is bool;
    }

    match /promociones/{promoId} {
      allow get: if true;
      allow list: if esStaff();
      allow create, update: if esStaff() && promocionValida(request.resource.data, promoId);
      allow delete: if esStaff();
    }

    // ---- Contadores: solo para el folio consecutivo de tickets (T-101, T-102...) ----
    // Cualquier cuenta con sesión puede leerlo y sumar 1; nada más.
    match /contadores/{nombre} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && nombre == 'tickets' && request.resource.data.ultimo == 101
                    && request.resource.data.keys().hasOnly(['ultimo']);
      allow update: if request.auth != null && nombre == 'tickets'
                    && request.resource.data.keys().hasOnly(['ultimo'])
                    && request.resource.data.ultimo == resource.data.ultimo + 1;
    }

    // ---- Tickets de atención a clientes (Etapa 4) ----
    // El id del documento ES el folio ("T-105"). Nunca se borran: lo resuelto queda en historial.
    //  - Cliente: crea tickets a su nombre (siempre "En proceso", en espera de soporte), lee solo
    //    los suyos y solo puede marcar como leídas las respuestas.
    //  - Soporte/administrador: leen todos, responden y cambian el estado.
    function ticketNuevoValido(d, ticketId) {
      return d.folio == ticketId && ticketId.matches('T-[0-9]+')
        && d.clienteId == request.auth.uid
        && d.clienteNombre is string && d.clienteNombre.size() <= 120
        && d.asunto in ['Duda sobre mi pedido', 'Cambio de producto', 'Facturación', 'Problema con monedero']
        && d.mensaje is string && d.mensaje.size() > 0 && d.mensaje.size() <= 2000
        && d.estado == 'En proceso'
        && d.esperaSoporte == true
        && d.leidoCliente == true
        && d.respuesta == ''
        && d.hilo is list && d.hilo.size() == 1
        && pedidoDeTicketValido(d);
    }
    // Producto de la queja (opcional): debe pertenecer a una compra del mismo cliente.
    function pedidoDeTicketValido(d) {
      return !('pedido' in d) || (d.pedido is map
        && d.pedido.keys().hasOnly(['ventaId', 'folio', 'productoId', 'producto', 'cantidad'])
        && d.pedido.ventaId is string && d.pedido.ventaId.size() > 0 && d.pedido.ventaId.size() <= 60
        && d.pedido.producto is string && d.pedido.producto.size() <= 200
        && get(/databases/$(database)/documents/ventas/$(d.pedido.ventaId)).data.clienteId == request.auth.uid);
    }
    // El cliente contesta en su propio ticket (evidencia, más datos) solo mientras esté "En proceso":
    // agrega exactamente UN mensaje suyo al final del hilo y lo deja en espera de soporte.
    function ticketRespondidoPorCliente() {
      let n = request.resource.data;
      let o = resource.data;
      return request.auth.uid == o.clienteId
        && o.estado == 'En proceso'
        && n.diff(o).affectedKeys().hasOnly(['hilo', 'esperaSoporte', 'leidoCliente', 'actualizadoEn'])
        && n.esperaSoporte == true && n.leidoCliente == true
        && n.hilo is list && n.hilo.size() == o.hilo.size() + 1
        && n.hilo[0:o.hilo.size()] == o.hilo
        && n.hilo[o.hilo.size()].de == 'cliente'
        && n.hilo[o.hilo.size()].texto is string
        && n.hilo[o.hilo.size()].texto.size() > 0 && n.hilo[o.hilo.size()].texto.size() <= 2000
        && n.hilo[o.hilo.size()].nombre is string && n.hilo[o.hilo.size()].nombre.size() <= 120;
    }
    function ticketRespondidoValido() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'respuesta', 'agente', 'agenteId', 'esperaSoporte', 'leidoCliente', 'hilo', 'actualizadoEn'])
        && request.resource.data.estado in ['En proceso', 'Solucionado', 'Cerrado']
        && request.resource.data.respuesta is string && request.resource.data.respuesta.size() <= 2000
        && request.resource.data.agenteId == request.auth.uid;
    }
    function ticketLeidoPorCliente() {
      return request.auth.uid == resource.data.clienteId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leidoCliente'])
        && request.resource.data.leidoCliente == true;
    }

    match /tickets/{ticketId} {
      allow read: if esSoporte() || (request.auth != null && resource.data.clienteId == request.auth.uid);
      allow create: if request.auth != null && ticketNuevoValido(request.resource.data, ticketId);
      allow update: if (esSoporte() && ticketRespondidoValido()) || ticketLeidoPorCliente() || ticketRespondidoPorCliente();
      allow delete: if false;
    }

    // ---- Monedero (Etapa 4, integrante 2) ----
    // monederos/{uid}: un monedero por cliente (id = uid). El saldo NUNCA se cambia solo:
    // cada cambio trae en "ultimoMovimientoId" el id del movimiento que se crea en la misma
    // operación, y las reglas comprueban que el saldo cambió exactamente ese monto.
    //   - Cliente: crea su monedero en $0, recarga (de $50 a $10,000) y paga compras.
    //   - Logística/administrador: al cancelar una orden pagada con monedero, se reembolsa.
    //   - Administrador: recargas manuales y ajustes (con motivo). Nunca saldo negativo.
    //   - Ventas (vendedor) y administrador: consultan saldos y movimientos (reportes).
    function casi(a, b) {
      return math.abs(a - b) < 0.01;
    }
    function movMonedero(id) {
      return getAfter(/databases/$(database)/documents/monedero_movimientos/$(id)).data;
    }
    function monederoNuevoValido(d, uid) {
      return d.keys().hasOnly(['clienteId', 'clienteNombre', 'saldo', 'totalRecargado', 'totalGastado', 'creadoEn', 'actualizadoEn'])
        && d.clienteId == uid
        && d.clienteNombre is string && d.clienteNombre.size() <= 120
        && d.saldo == 0 && d.totalRecargado == 0 && d.totalGastado == 0;
    }
    function recargaPorCliente(uid) {
      let n = request.resource.data;
      let o = resource.data;
      let m = movMonedero(n.ultimoMovimientoId);
      return n.diff(o).affectedKeys().hasOnly(['saldo', 'totalRecargado', 'ultimoMovimientoId', 'actualizadoEn'])
        && n.ultimoMovimientoId is string
        && m.tipo == 'Recarga' && m.clienteId == uid && m.usuarioId == uid
        && m.monto >= 50 && m.monto <= 10000
        && casi(n.saldo, o.saldo + m.monto)
        && casi(m.saldoNuevo, n.saldo)
        && casi(n.totalRecargado, o.get('totalRecargado', 0) + m.monto);
    }
    function pagoConMonedero(uid) {
      let n = request.resource.data;
      let o = resource.data;
      let m = movMonedero(n.ultimoMovimientoId);
      let venta = getAfter(/databases/$(database)/documents/ventas/$(m.ventaId)).data;
      return n.diff(o).affectedKeys().hasOnly(['saldo', 'totalGastado', 'ultimoMovimientoId', 'actualizadoEn'])
        && n.ultimoMovimientoId is string
        && m.tipo == 'Pago' && m.clienteId == uid && m.monto > 0
        && n.saldo >= 0
        && casi(n.saldo, o.saldo - m.monto)
        && casi(n.totalGastado, o.get('totalGastado', 0) + m.monto)
        && m.ventaId is string && m.ventaId.size() > 0
        && !exists(/databases/$(database)/documents/ventas/$(m.ventaId))   // la venta nace en esta misma transacción
        && venta.clienteId == uid
        && venta.metodoPagoClave == 'monedero'
        && casi(venta.total, m.monto);
    }
    function reembolsoPorCancelacion(uid) {
      let n = request.resource.data;
      let o = resource.data;
      let m = movMonedero(n.ultimoMovimientoId);
      let antes = get(/databases/$(database)/documents/ventas/$(m.ventaId)).data;
      return esScm()
        && n.diff(o).affectedKeys().hasOnly(['saldo', 'totalGastado', 'ultimoMovimientoId', 'actualizadoEn'])
        && m.tipo == 'Reembolso' && m.clienteId == uid
        && casi(n.saldo, o.saldo + m.monto)
        && antes.clienteId == uid
        && antes.metodoPagoClave == 'monedero'
        && antes.estado != 'Cancelada'
        && getAfter(/databases/$(database)/documents/ventas/$(m.ventaId)).data.estado == 'Cancelada'
        && casi(antes.total, m.monto);
    }
    function ajusteDeMonederoValido(uid) {
      let n = request.resource.data;
      let m = movMonedero(n.ultimoMovimientoId);
      let saldoAntes = resource == null ? 0 : resource.data.saldo;
      return n.saldo is number && n.saldo >= 0
        && m.clienteId == uid && m.tipo in ['Ajuste', 'Recarga'] && m.usuarioId == request.auth.uid
        && casi(m.saldoNuevo, n.saldo)
        && casi(math.abs(n.saldo - saldoAntes), m.monto);
    }

    match /monederos/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || esStaff();
      allow create: if (request.auth != null && request.auth.uid == uid && monederoNuevoValido(request.resource.data, uid))
                    || (esAdmin() && ajusteDeMonederoValido(uid));
      allow update: if (request.auth != null && request.auth.uid == uid && (recargaPorCliente(uid) || pagoConMonedero(uid)))
                    || reembolsoPorCancelacion(uid)
                    || (esAdmin() && ajusteDeMonederoValido(uid));
      allow delete: if false;
    }

    // Historial del monedero: solo se agregan movimientos (ni se editan ni se borran) y cada uno
    // debe ser el "ultimoMovimientoId" del monedero que cambia en la misma operación.
    function movimientoMonederoValido(d, movId) {
      return d.clienteId is string && d.clienteId.size() > 0
        && d.tipo in ['Recarga', 'Pago', 'Ajuste', 'Reembolso']
        && d.efecto in ['abono', 'cargo']
        && d.monto is number && d.monto > 0
        && d.saldoNuevo is number && d.saldoNuevo >= 0
        && d.usuarioId == request.auth.uid
        && getAfter(/databases/$(database)/documents/monederos/$(d.clienteId)).data.ultimoMovimientoId == movId;
    }

    match /monedero_movimientos/{movId} {
      allow read: if (request.auth != null && resource.data.clienteId == request.auth.uid) || esStaff();
      allow create: if request.auth != null && movimientoMonederoValido(request.resource.data, movId)
                    && ((request.resource.data.clienteId == request.auth.uid && request.resource.data.tipo in ['Recarga', 'Pago'])
                        || (esScm() && request.resource.data.tipo == 'Reembolso')
                        || (esAdmin() && request.resource.data.tipo in ['Ajuste', 'Recarga']));
      allow update, delete: if false;
    }

    // ---- Carrito persistente (Etapa 4): modelos Carrito y CarritoDetalle del PDF ----
    // carritos/{uid}: un carrito por cliente (id = uid). Solo el dueño lo escribe; el personal
    // de ventas lo consulta (carritos activos / abandonados). El stock se vuelve a validar al pagar
    // dentro de la transacción de crearVenta(), así que aquí solo se revisa la forma de los datos.
    function carritoValido(d, uid) {
      return d.clienteId == uid
        && d.estado in ['Activo', 'Vacío', 'Comprado', 'Expirado']
        && d.numProductos is int && d.numProductos >= 0 && d.numProductos <= 100
        && d.totalPiezas is int && d.totalPiezas >= 0
        && d.subtotal is number && d.subtotal >= 0
        && d.resumen is list && d.resumen.size() <= 30
        && d.clienteNombre is string && d.clienteNombre.size() <= 120
        && d.ultimaVentaId is string && d.ultimaVentaId.size() <= 60;
    }
    function detalleCarritoValido(d, productoId) {
      return d.keys().hasOnly(['productoId', 'nombre', 'cantidad', 'precioUnitario', 'imagen', 'agregadoEn'])
        && d.productoId == productoId
        && d.nombre is string && d.nombre.size() <= 200
        && d.cantidad is int && d.cantidad >= 1 && d.cantidad <= 99
        && d.precioUnitario is number && d.precioUnitario >= 0
        && d.imagen is string && d.imagen.size() <= 500
        && d.agregadoEn is number;
    }

    match /carritos/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || esStaff();
      allow create, update: if request.auth != null && request.auth.uid == uid && carritoValido(request.resource.data, uid);
      allow delete: if request.auth != null && request.auth.uid == uid;

      match /detalle/{productoId} {
        allow read: if (request.auth != null && request.auth.uid == uid) || esStaff();
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && detalleCarritoValido(request.resource.data, productoId);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---- Foto de perfil del cliente (Etapa 4) ----
    // fotos_perfil/{uid}: solo el dueño la cambia o la quita; el personal la ve en el CRM.
    // Solo se acepta una imagen JPEG reducida (máximo ~200 KB de texto).
    match /fotos_perfil/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || esStaff();
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['foto', 'actualizadoEn'])
                            && request.resource.data.foto is string
                            && request.resource.data.foto.size() <= 200000
                            && request.resource.data.foto.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Cualquier otra colección queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
