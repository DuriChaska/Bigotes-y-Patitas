rules_version = '2';

// Reglas de seguridad de Firestore para "Bigotes y Patitas".
// Cópialas en Firebase Console → Firestore Database → Reglas,
// o despliégalas con la CLI de Firebase (firebase deploy --only firestore:rules).
//
// Lógica:
//  - clientes: CUALQUIERA (sin sesión) puede CREAR un cliente nuevo — es lo
//    que usa el formulario público de registro del sitio. Pero leer, editar
//    o borrar clientes sigue exigiendo sesión iniciada (solo el panel admin).
//  - interacciones: cualquier usuario con sesión iniciada puede leer y
//    escribir (administradores y vendedores tienen el mismo acceso aquí).
//  - usuarios: cualquiera con sesión puede LEER (para saber su propio rol
//    al entrar), pero solo alguien cuyo propio documento diga
//    rol == "administrador" puede crear, editar o borrar perfiles de otros.

service cloud.firestore {
  match /databases/{database}/documents {

    match /clientes/{clienteId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.nombre is string
                    && request.resource.data.correo is string
                    && request.resource.data.etapa == 'Prospecto';
    }

    match /interacciones/{interaccionId} {
      allow read, write: if request.auth != null;
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    // ---- SCM (cadena de suministros): SOLO administradores ----
    // Ni vendedores, ni clientes, ni cuentas sin perfil en "usuarios" pueden
    // leer o escribir aquí. Esta es la barrera real: el menú oculto y la
    // redirección de las páginas son solo cortesía de la interfaz.
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }

    function productoScmValido(d) {
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.stock is int && d.stock >= 0
        && d.stockMin is int && d.stockMin >= 0
        && d.estrategia in ['PUSH', 'PULL']
        && d.costo is number && d.costo >= 0;
    }

    match /scm_productos/{productoId} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin() && productoScmValido(request.resource.data);
    }

    function proveedorScmValido(d) {
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.contacto is string && d.contacto.size() <= 120
        && d.correo is string && d.correo.size() <= 200
        && d.telefono is string && d.telefono.size() <= 40
        && d.direccion is string && d.direccion.size() <= 300;
    }

    match /scm_proveedores/{proveedorId} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin() && proveedorScmValido(request.resource.data);
    }

    // Cualquier otra colección queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
